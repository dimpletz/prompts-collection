{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/scripts/inject-developer.sh\"",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/inject-developer.ps1\""
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "bash": "bash \"${PLUGIN_ROOT}/scripts/inject-developer.sh\"",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/inject-developer.ps1\""
      }
    ]
  }
}
